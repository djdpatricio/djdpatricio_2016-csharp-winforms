# Visual Studio Solution User Options
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Cache / Temporary Files
.vs/

# NuGet Packages
packages/
*.nupkg
*.nuget.props
*.nuget.targets

# Build Outputs
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Pp]ublish/
# Program Database files (debugging symbols)
*.pdb
# General log files
*.log
# Backup files
*.bak

# JetBrains Rider/ReSharper User Settings
# As seen: DJDPatricio.LaundryShop.sln.DotSettings.user
*.DotSettings.user
*.resharper.user
# Specific ReSharper cache directories
_ReSharper*/

# Other temporary or generated files
# If you see them appear, consider adding them
*.tmp

# Signing keys and certificates (ClickOnce publishing uses the developer's own certificate)
*.pfx
*.p12
*.snk
